# Copiar este archivo como .env y ajustar si hace falta

# Desarrollo: la app llama a /api y Vite lo reenvía al backend (evita CORS al usar la IP).
# Producción móvil: .env.production apunta VITE_API_URL directo al backend, porque
# dentro del WebView no existe el proxy /api.
VITE_API_URL=/api

# IP del backend en la red. En la misma máquina: http://localhost:8000
VITE_BACKEND_URL=http://192.168.20.49:8000

# false = login y catálogos (tipos, bodegas, usuarios, roles, permisos) contra la API real.
# true  = modo demo, todo con datos falsos. Los tests fuerzan true en vite.config.js.
VITE_USE_MOCKS=false

# /facturas ya está publicado con el contrato definitivo (FE-0001, estados
# emitida/firmada/recibida). Poner true solo para trabajar sin backend.
VITE_FACTURAS_MOCKS=false
