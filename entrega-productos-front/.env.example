# Copiar este archivo como .env y ajustar si hace falta

# La app llama a /api y Vite lo reenvía al backend (evita CORS al usar la IP)
VITE_API_URL=/api

# IP del backend en la red. En la misma máquina: http://localhost:8000
VITE_BACKEND_URL=http://192.168.20.49:8000

# true = usar datos falsos mientras el backend no esté listo
# false = usar la API real (valor recomendado para el entorno local actual)
# OJO: los tests unitarios fuerzan true en vite.config.js, sin importar este archivo
VITE_USE_MOCKS=true
